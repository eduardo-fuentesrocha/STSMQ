datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id                         String   @id @default(uuid())
  numeroEmpleado             String   @unique
  nombreCompleto             String
  email                      String?  @unique
  password                   String
  rol                        String   @default("agremiado") // "agremiado", "admin" o "secretario_general"
  
  // Campos de la Credencial Sindical
  puesto                     String?
  departamento               String?
  fechaIngreso               String?
  curp                       String?
  nss                        String?
  tipoSangre                 String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  vigencia                   String?

  createdAt                  DateTime @default(now())

  // Relaciones anidadas
  familiares          Familiar[]
  solicitudesBecas    SolicitudBeca[]
  solicitudesMaterial SolicitudMaterial[]
  solicitudesMatr     SolicitudMatrimonio[]
  solicitudesNac      SolicitudNacimiento[]
  solicitudJubilacion SolicitudJubilacion?
}

model Familiar {
  id             String   @id @default(uuid())
  numeroEmpleado String
  nombreCompleto String
  parentesco     String   // "Cónyuge" o "Hijo(a)"
  estatus        String   @default("Aprobado")
  createdAt      DateTime @default(now())

  usuario        Usuario  @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}

model SolicitudNacimiento {
  id                String    @id @default(uuid())
  numeroEmpleado    String
  nombreHijo        String
  actaUrl           String
  estatus           String    @default("En Revisión")
  motivoRechazo     String?
  notificacionVista Boolean   @default(false)
  gestionadoPor     String?
  fechaGestion      DateTime?
  createdAt         DateTime  @default(now())

  usuario           Usuario   @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}

model SolicitudMatrimonio {
  id                String    @id @default(uuid())
  numeroEmpleado    String
  nombreConyuge     String
  tipoUnion         String    // "Matrimonio" o "Concubinato"
  actaUrl           String   
  estatus           String    @default("En Revisión")
  motivoRechazo     String?
  notificacionVista Boolean   @default(false)
  gestionadoPor     String?
  fechaGestion      DateTime?
  createdAt         DateTime  @default(now())

  usuario           Usuario   @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}

model SolicitudBeca {
  id                String    @id @default(uuid())
  numeroEmpleado    String
  nombreHijo        String
  nivelEducativo    String
  actaUrl           String   
  boletaUrl         String   
  estatus           String    @default("En Revisión")
  motivoRechazo     String?
  notificacionVista Boolean   @default(false)
  gestionadoPor     String?
  fechaGestion      DateTime?
  createdAt         DateTime  @default(now())

  usuario           Usuario   @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}

model SolicitudMaterial {
  id                  String    @id @default(uuid())
  domicilioInmueble   String
  cantidadTepetate    Int       @default(0)
  cantidadArena       Int       @default(0)
  cantidadGrava       Int       @default(0)
  cantidadPiedraNegra Int       @default(0)
  cantidadCantera     Int       @default(0)
  numeroEmpleado      String
  estatus             String    @default("En Revisión")
  motivoRechazo       String?
  notificacionVista   Boolean   @default(false)
  gestionadoPor       String?
  fechaGestion        DateTime?
  createdAt           DateTime  @default(now())

  usuario             Usuario   @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}

model SolicitudUtiles {
  id                String    @id @default(cuid())
  numeroEmpleado    String
  nombreHijo        String
  nivelEducativo    String    // Primaria, Secundaria, Preparatoria
  boletaUrl         String    // Boleta del ciclo que termina
  inscripcionUrl    String    // Recibo de inscripción al nuevo ciclo
  estatus           String    @default("En Revisión") // En Revisión, Aprobada, Rechazada
  motivoRechazo     String?
  notificacionVista Boolean   @default(false)
  gestionadoPor     String?
  fechaGestion      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SolicitudJubilacion {
  id                          String    @id @default(uuid())
  numeroEmpleado              String    @unique
  telefonoContacto            String

  actaNacimientoUrl           String
  actaNacimientoEstatus       String    @default("En Revisión")
  actaNacimientoMotivo        String?

  ineUrl                      String
  ineEstatus                  String    @default("En Revisión")
  ineMotivo                   String?

  semanasCotizadasImssUrl     String
  semanasCotizadasImssEstatus String    @default("En Revisión")
  semanasCotizadasImssMotivo  String?

  recibosNominaUrl            String
  recibosNominaEstatus        String    @default("En Revisión")
  recibosNominaMotivo         String?

  estatus                     String    @default("En Revisión")
  motivoRechazo               String?
  notificacionVista           Boolean   @default(false)
  gestionadoPor               String?
  fechaGestion                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  usuario                     Usuario   @relation(fields: [numeroEmpleado], references: [numeroEmpleado], onDelete: Cascade)
}